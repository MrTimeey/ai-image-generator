# --- Anbieter (mindestens einer ist Pflicht) ---
OPEN_AI_API_KEY=<API-Key von https://platform.openai.com/settings/profile?tab=api-keys>
# Optional. Nur setzen, wenn der Schluessel zu einer bestimmten Organisation
# gehoert — ein veraltetes Org-Id quittiert OpenAI mit 401 auf jedem Aufruf.
OPEN_AI_ORG_ID=
BFL_API_KEY=<API-Key von https://api.bfl.ai>

# --- Anmeldung ueber Authentik ---
AUTH_ENABLED=<true|false - Default: false>
# Die vier folgenden sind Pflicht, sobald AUTH_ENABLED=true ist.
OIDC_ISSUER=https://auth.mrtimeey.com/application/o/ai-image-generator/
OIDC_CLIENT_ID=<Client-ID des OIDC-Providers>
OIDC_CLIENT_SECRET=<Client-Secret des OIDC-Providers>
SESSION_SECRET=<mind. 32 Zeichen, signiert das Sitzungs-Cookie>
# Optional: nur Mitglieder dieser Authentik-Gruppe kommen rein. Leer = jeder,
# der sich anmelden kann.
OIDC_ALLOWED_GROUP=

# --- Adresse ---
# Muss die oeffentliche Adresse sein: daraus baut die App die OIDC-Redirect-URI.
PUBLIC_BASE_URL=https://ai.mrtimeey.com
AI_IMAGE_GENERATOR_PORT=<Port - Default: 3000>
AI_IMAGE_GENERATOR_OUTPUT_PATH=<Bilderordner - Default: ./../ai-images>
