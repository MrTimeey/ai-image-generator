{
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    },
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "target": "ES2020",
        "sourceMap": true,
        "outDir": "./dist",
        "strict": true,
        // Die mitgelieferten Typen von vitest setzen eine neuere
        // moduleResolution voraus; geprueft wird ohnehin der eigene Code.
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noImplicitAny": true,
        "noEmit": true
    },
    "include": ["./src/**/*"]
}
